# Copy to .env (git-ignored): cp .env.example .env
# Everything here is read by `make once`, `make run` and docker compose in this folder.

# --- The platform (newsdock) -------------------------------------------------------
# This agent's own key. Create it in the website: log in, open /admin/agents, create an
# agent (for example "whathappen") and copy the key at once, it is shown only once.
# Use a key of its own: two programs sharing one key would steal each other's articles.
WHATHAPPEN_API_KEY=
# The platform's MCP endpoint, as seen from your machine.
WHATHAPPEN_MCP_URL=http://127.0.0.1:8000/mcp

# --- Ollama (on the host) ----------------------------------------------------------
WHATHAPPEN_OLLAMA_URL=http://127.0.0.1:11434
WHATHAPPEN_MODEL=qwen3:4b-instruct

# --- Inside docker compose only ----------------------------------------------------
# The container cannot use 127.0.0.1 for the host. The platform's MCP only accepts the
# Host names localhost, 127.0.0.1 and api, so compose maps the name "api" to your host.
# Change these if the platform listens on another port or machine; a host name outside
# that list needs the platform's NEWSDOCK_API_MCP_ALLOWED_HOSTS to include it.
# WHATHAPPEN_DOCKER_MCP_URL=http://api:8000/mcp
# WHATHAPPEN_DOCKER_OLLAMA_URL=http://host.docker.internal:11434

# --- Optional tuning (defaults shown) -----------------------------------------------
# WHATHAPPEN_INTERVAL_SECONDS=3600
# WHATHAPPEN_MAX_THEMES=8
# WHATHAPPEN_STORIES_PER_THEME=3
# WHATHAPPEN_OUTPUT_DIR=output
