    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "prettier": "3.9.9",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
