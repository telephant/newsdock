# Copy to .env (git-ignored): cp .env.example .env
# Placeholders for local development only. Never put real secrets in this file.
POSTGRES_USER=newsdock
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=newsdock
# Host port for Postgres. 5433 because a local Postgres often already uses 5432.
POSTGRES_PORT=5433
# For tools running on the host (containers use postgres:5432 inside the compose network)
DATABASE_URL=postgresql+psycopg://newsdock:change-me-local-only@localhost:5433/newsdock
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
# Host ports for the published services (container ports are fixed: api 8000, web 3000).
API_PORT=8000
WEB_PORT=3000
# Non-secret settings live in infra/config/newsdock.yaml (env vars override it);
# secrets such as DATABASE_URL and POSTGRES_PASSWORD belong here, never in that file.
